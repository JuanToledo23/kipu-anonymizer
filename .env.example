# Copy to .env and fill in. Never commit .env.
# Optional variables are commented out: uncomment one only to override its default
# (an empty value is not the same as unset).

# Required. Secret seed for deterministic pseudonyms (HMAC). Generate once, never rotate:
# rotating it changes the surrogates of every person created afterwards.
PSEUDONYM_SECRET=

# Sources API base URL and bearer token (also accepted in the POST /run body).
FUENTES_URL=
FUENTES_TOKEN=

# Directory for the registry, LLM cache, jobs and output. Default: data
# DATA_DIR=

# Optional bearer token required by every route except /health. Empty: no auth.
# ENTRYPOINT_TOKEN=

# HTTP port of the service. Default: 9000
# PORT=

# LLM layer. OpenRouter is primary; Anthropic is the fallback. With neither key: rules only.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# true/false. Default: true (effective only with an API key).
# LLM_ENABLED=

# Per-run spending cap in USD; once reached, the run finishes with rules only. Default: 5
# LLM_MAX_COST_USD=

# Model slug overrides. Defaults: anthropic/claude-haiku-5.5, google/gemini-3.5-flash-lite,
# anthropic/claude-sonnet-5.5 (adjudicator).
# LLM_PRIMARY=
# LLM_SECOND=
# LLM_STRONG=

# Concurrent model calls. Default: 12
# LLM_CONCURRENCY=
